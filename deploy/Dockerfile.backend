FROM rust:1.95-bookworm AS builder
WORKDIR /app
COPY src/backend ./src/backend
RUN cargo build --release --manifest-path src/backend/Cargo.toml

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/src/backend/target/release/parquet-viewer-backend /usr/local/bin/parquet-viewer-backend
ENV PV_HOST=0.0.0.0 PV_PORT=8080
EXPOSE 8080
ENTRYPOINT ["parquet-viewer-backend"]
